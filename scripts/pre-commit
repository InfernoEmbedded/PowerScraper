#!/usr/bin/env bash

# Premium git pre-commit hook for PowerScraper

# Colors for terminal output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo -e "${BLUE}=== PowerScraper Pre-Commit Checks ===${NC}"

# Add local cargo path to PATH if not already present
if ! command -v cargo &> /dev/null; then
    export PATH="$HOME/.cargo/bin:$PATH"
fi

# 1. Format check
if cargo --list | grep -q "fmt"; then
    echo -n "Checking code formatting (cargo fmt)... "
    if ! cargo fmt --check; then
        echo -e "${RED}FAILED${NC}"
        echo -e "${YELLOW}Please run 'cargo fmt' to fix formatting before committing.${NC}"
        exit 1
    fi
    echo -e "${GREEN}PASSED${NC}"
else
    echo -e "${YELLOW}Skipping format check: cargo fmt not installed.${NC}"
fi

# 2. Clippy static analysis
if cargo --list | grep -q "clippy"; then
    echo -n "Running linter and warnings check (cargo clippy)... "
    if ! cargo clippy --all-targets -- -D warnings; then
        echo -e "${RED}FAILED${NC}"
        echo -e "${YELLOW}Please resolve all compiler/clippy warnings and errors.${NC}"
        exit 1
    fi
    echo -e "${GREEN}PASSED${NC}"
else
    echo -e "${YELLOW}Skipping clippy check: cargo clippy not installed.${NC}"
fi

# 3. Documentation build check
echo -n "Checking documentation build (cargo doc)... "
if ! RUSTDOCFLAGS="-D warnings" cargo doc --no-deps &> /dev/null; then
    echo -e "${RED}FAILED${NC}"
    echo -e "${YELLOW}Please fix any documentation compilation errors/warnings.${NC}"
    exit 1
fi
echo -e "${GREEN}PASSED${NC}"

# 4. Run tests and collect coverage
RUSTC_SYSROOT=$(rustc --print sysroot)
HOST_TRIPLE=$(rustc -vV | grep host | awk '{print $2}')
LLVM_PROFDATA="$RUSTC_SYSROOT/lib/rustlib/$HOST_TRIPLE/bin/llvm-profdata"
LLVM_COV="$RUSTC_SYSROOT/lib/rustlib/$HOST_TRIPLE/bin/llvm-cov"

if [ -f "$LLVM_PROFDATA" ] && [ -f "$LLVM_COV" ]; then
    echo "Running unit tests with coverage instrumentation..."
    # Clean coverage raw profile files and stale test binaries
    rm -f *.profraw
    rm -f target/debug/deps/PowerScraper-* target/debug/deps/integration_test-*
    cargo clean -p PowerScraper &> /dev/null

    CARGO_INCREMENTAL=0 RUSTFLAGS="-C instrument-coverage" cargo test
    if [ $? -ne 0 ]; then
        echo -e "${RED}Unit/integration tests failed!${NC}"
        exit 1
    fi

    # Dynamically locate all compiled test executables
    OBJECTS=""
    for bin in target/debug/deps/PowerScraper-* target/debug/deps/integration_test-*; do
        if [ -x "$bin" ] && [[ ! "$bin" == *.d ]]; then
            OBJECTS="$OBJECTS --object $bin"
        fi
    done

    if [ -n "$OBJECTS" ]; then
        # Merge profile data
        "$LLVM_PROFDATA" merge -sparse *.profraw -o cov.profdata
        if [ $? -eq 0 ]; then
            # Extract coverage metrics using all compiled objects
            overall_cov=$("$LLVM_COV" report --instr-profile=cov.profdata $OBJECTS --ignore-filename-regex="\.cargo|rustc|serial_meters|main\.rs|web_assets\.rs" | grep "TOTAL" | awk '{print $10}')
            overall_val=$(echo "$overall_cov" | tr -d '%')

            pm_cov=$("$LLVM_COV" report --instr-profile=cov.profdata $OBJECTS --ignore-filename-regex="\.cargo|rustc|serial_meters|main\.rs|web_assets\.rs" | grep "power_manager.rs" | awk '{print $10}')
            pm_val=$(echo "$pm_cov" | tr -d '%')

            # Clean up temporary profile files
            rm -f *.profraw cov.profdata

            # Verify coverage values are parsed
            if [ -n "$overall_val" ] && [ -n "$pm_val" ]; then
                # Display coverage report summary
                echo -e "${BLUE}--- Coverage Summary ---${NC}"
                echo -e "Overall Line Coverage:      ${GREEN}${overall_val}%${NC}"
                echo -e "power_manager.rs Coverage:  ${GREEN}${pm_val}%${NC}"

                # Define thresholds
                OVERALL_THRESHOLD=90.0
                
                # Verify overall coverage
                if awk "BEGIN { if ($overall_val < $OVERALL_THRESHOLD) exit 0; else exit 1 }"; then
                    echo -e "${RED}FAILED: Overall coverage ($overall_val%) is below the required threshold of $OVERALL_THRESHOLD%${NC}"
                    exit 1
                fi
            else
                echo -e "${YELLOW}Warning: Coverage metrics could not be extracted.${NC}"
            fi
        else
            echo -e "${YELLOW}Warning: Failed to merge profile data.${NC}"
            rm -f *.profraw
        fi
    else
        echo -e "${YELLOW}Warning: Could not find test executables to generate coverage.${NC}"
    fi
else
    echo -e "${YELLOW}LLVM coverage tools not found. Running standard unit tests...${NC}"
    cargo test
    if [ $? -ne 0 ]; then
        echo -e "${RED}Unit/integration tests failed!${NC}"
        exit 1
    fi
fi

# 5. Bump version by 0.0.1
echo -n "Bumping version in Cargo.toml... "
VERSION=$(grep '^version\s*=\s*' Cargo.toml | cut -d '"' -f2)
if [ -z "$VERSION" ]; then
    echo -e "${RED}FAILED: Could not find version in Cargo.toml${NC}"
    exit 1
fi
IFS='.' read -r major minor patch <<< "$VERSION"
patch=$((patch + 1))
NEW_VERSION="$major.$minor.$patch"
sed -i "s/^version = \"$VERSION\"/version = \"$NEW_VERSION\"/" Cargo.toml
git add Cargo.toml
if [ -f "Cargo.lock" ]; then
    cargo metadata --format-version 1 &> /dev/null
    git add Cargo.lock
fi
echo -e "${GREEN}Bumped to $NEW_VERSION${NC}"

echo -e "${GREEN}All checks passed successfully! Commit approved.${NC}"
exit 0
